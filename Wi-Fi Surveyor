{"cells":[{"cell_type":"code","source":"import tkinter as tk\nfrom tkinter import filedialog, messagebox, simpledialog, ttk\nimport subprocess\nimport re\nimport csv\nimport datetime\nimport threading\nimport time\nimport os\nimport platform\nimport math\nfrom collections import deque\n\n# Graphics and Plotting\nfrom PIL import Image, ImageTk, ImageDraw\nimport numpy as np\nimport matplotlib\nmatplotlib.use('TkAgg') # Changed to TkAgg to allow interactive popups\nimport matplotlib.pyplot as plt\nfrom matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\nfrom scipy.interpolate import griddata\n\n# Optional Dependencies\ntry:\n    import speedtest\nexcept ImportError:\n    speedtest = None\n\n# --- Configuration ---\nLOG_FOLDER = \"logs\"\nGRAPHS_FOLDER = os.path.join(LOG_FOLDER, \"graphs\")\nPOINTS_FILE = os.path.join(LOG_FOLDER, \"survey_points.csv\")\n\nfor folder in [LOG_FOLDER, GRAPHS_FOLDER]:\n    if not os.path.exists(folder):\n        os.makedirs(folder)\n\n# --- Helper Functions ---\n\ndef get_wifi_info():\n    \"\"\"Get current BSSID, SSID, and Signal Strength (%) using netsh (Windows).\"\"\"\n    data = {\"bssid\": \"Unknown\", \"ssid\": \"Disconnected\", \"signal\": 0}\n    try:\n        if platform.system() == \"Windows\":\n            # Use netsh on Windows\n            # The creationflags=0x08000000 suppresses the console window popping up\n            startupinfo = subprocess.STARTUPINFO()\n            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW\n            \n            out = subprocess.check_output(\n                [\"netsh\", \"wlan\", \"show\", \"interfaces\"], \n                stderr=subprocess.STDOUT,\n                startupinfo=startupinfo\n            ).decode(\"utf-8\", errors=\"ignore\")\n            \n            bssid = re.search(r\"BSSID\\s*:\\s*([0-9A-Fa-f:]+)\", out)\n            ssid = re.search(r\"SSID\\s*:\\s*(.+)\", out)\n            signal = re.search(r\"Signal\\s*:\\s*(\\d+)%\", out)\n            \n            if bssid: data[\"bssid\"] = bssid.group(1).strip()\n            if ssid and \"BSSID\" not in ssid.group(0): data[\"ssid\"] = ssid.group(1).strip()\n            if signal: data[\"signal\"] = int(signal.group(1))\n        else:\n            # Mock data for Mac/Linux if netsh isn't available\n            import random\n            data[\"ssid\"] = \"Demo Wi-Fi\"\n            data[\"bssid\"] = \"00:11:22:33:44:55\"\n            # Simulate a bit of walking variance\n            data[\"signal\"] = int(60 + 20 * math.sin(time.time()))\n            \n    except Exception as e:\n        print(f\"Error scanning Wi-Fi: {e}\")\n    return data\n\ndef run_background_speedtest(callback):\n    \"\"\"Runs speedtest in a thread to avoid freezing UI.\"\"\"\n    def _run():\n        if not speedtest:\n            callback(None, \"Speedtest library not installed.\\nRun: pip install speedtest-cli\")\n            return\n        try:\n            st = speedtest.Speedtest()\n            st.get_best_server()\n            dl = st.download() / 1_000_000\n            ul = st.upload() / 1_000_000\n            ping = st.results.ping\n            callback({\"download\": dl, \"upload\": ul, \"ping\": ping}, None)\n        except Exception as e:\n            callback(None, str(e))\n    threading.Thread(target=_run, daemon=True).start()\n\n# --- Main Application ---\n\nclass WifiSurveyApp:\n    def __init__(self, root):\n        self.root = root\n        self.root.title(\"Live Wi-Fi Heatmap Surveyor v2\")\n        self.root.geometry(\"1200x750\")\n        \n        # State\n        self.survey_points = [] # List of (x, y, signal)\n        self.notes = []         # List of (x, y, text) for labels\n        self.walls = []         # List of (x1, y1, x2, y2)\n        self.speedtest_history = [] # List of dicts {x, y, dl, ul}\n        \n        # Graphics State\n        self.floorplan_img_orig = None\n        self.floorplan_photo = None\n        self.heatmap_photo = None\n        self.scale = 1.0\n        self.offset_x = 0\n        self.offset_y = 0\n        self.logging_active = False\n        self.current_wifi = {}\n        \n        # Drawing Line State\n        self.line_start = None\n        self.temp_line_id = None\n        \n        # --- UI Layout ---\n        main_pane = tk.PanedWindow(root, orient=tk.HORIZONTAL)\n        main_pane.pack(fill=tk.BOTH, expand=True)\n        \n        # Left Panel (Controls)\n        self.left_frame = tk.Frame(main_pane, bg=\"#f0f0f0\", width=280)\n        main_pane.add(self.left_frame, minsize=250)\n        \n        # Right Panel (Canvas)\n        self.right_frame = tk.Frame(main_pane, bg=\"#444\")\n        main_pane.add(self.right_frame, minsize=400)\n        \n        self._setup_controls()\n        self._setup_canvas()\n        \n        # Start Background Polling\n        self.running = True\n        self.poll_wifi()\n\n    def _setup_controls(self):\n        lbl_style = {\"bg\": \"#f0f0f0\", \"font\": (\"Arial\", 10)}\n        \n        # Status Section\n        frame_status = tk.LabelFrame(self.left_frame, text=\"Current Connection\", bg=\"#f0f0f0\", padx=5, pady=5)\n        frame_status.pack(fill=tk.X, padx=5, pady=5)\n        \n        self.lbl_ssid = tk.Label(frame_status, text=\"SSID: ---\", **lbl_style)\n        self.lbl_ssid.pack(anchor=\"w\")\n        \n        self.lbl_bssid = tk.Label(frame_status, text=\"BSSID: ---\", font=(\"Courier\", 9), bg=\"#f0f0f0\")\n        self.lbl_bssid.pack(anchor=\"w\")\n        \n        self.lbl_signal = tk.Label(frame_status, text=\"Signal: 0%\", font=(\"Arial\", 16, \"bold\"), fg=\"green\", bg=\"#f0f0f0\")\n        self.lbl_signal.pack(anchor=\"w\")\n\n        # Live Monitor Button\n        tk.Button(frame_status, text=\"Open Live Signal Monitor\", bg=\"#d1e7dd\", \n                  command=self.open_live_monitor).pack(fill=tk.X, pady=5)\n\n        # Tools Section\n        frame_tools = tk.LabelFrame(self.left_frame, text=\"Tools\", bg=\"#f0f0f0\", padx=5, pady=5)\n        frame_tools.pack(fill=tk.X, padx=5, pady=5)\n        \n        tk.Button(frame_tools, text=\"Load Floor Plan\", command=self.load_floorplan).pack(fill=tk.X, pady=2)\n        tk.Button(frame_tools, text=\"Clear All Points\", command=self.clear_points).pack(fill=tk.X, pady=2)\n        \n        # Speedtest Section\n        frame_speed = tk.LabelFrame(self.left_frame, text=\"Speedtest\", bg=\"#f0f0f0\", padx=5, pady=5)\n        frame_speed.pack(fill=tk.X, padx=5, pady=5)\n        \n        tk.Button(frame_speed, text=\"Run Point Speedtest\", command=self.trigger_speedtest).pack(fill=tk.X, pady=2)\n        tk.Button(frame_speed, text=\"View Speed History Graph\", command=self.show_speedtest_graph).pack(fill=tk.X, pady=2)\n        \n        # Mode Selection\n        frame_mode = tk.LabelFrame(self.left_frame, text=\"Interaction Mode\", bg=\"#f0f0f0\", padx=5, pady=5)\n        frame_mode.pack(fill=tk.X, padx=5, pady=5)\n        \n        self.mode_var = tk.StringVar(value=\"point\")\n        modes = [\n            (\"Record Signal Point\", \"point\"),\n            (\"Draw Lines (Walls)\", \"line\"),\n            (\"Add Text Label\", \"text\"),\n            (\"Drag/Pan Map\", \"pan\")\n        ]\n        \n        for text, val in modes:\n            tk.Radiobutton(frame_mode, text=text, variable=self.mode_var, value=val, bg=\"#f0f0f0\").pack(anchor=\"w\")\n\n        # Legend\n        frame_legend = tk.Frame(self.left_frame, bg=\"#f0f0f0\", pady=10)\n        frame_legend.pack(fill=tk.X, padx=5)\n        tk.Label(frame_legend, text=\"Coverage Legend:\", bg=\"#f0f0f0\", font=(\"Arial\", 9, \"bold\")).pack(anchor=\"w\")\n        self._draw_legend_bar(frame_legend)\n\n    def _draw_legend_bar(self, parent):\n        canvas = tk.Canvas(parent, height=20, width=200, bg=\"white\", highlightthickness=0)\n        canvas.pack(pady=5)\n        for i in range(200):\n            r = int(255 * (i/200))\n            g = int(255 * (1 - (i/200)))\n            color = f\"#{r:02x}{g:02x}00\"\n            canvas.create_line(i, 0, i, 20, fill=color)\n        canvas.create_text(10, 10, text=\"Strong\", fill=\"white\", font=(\"Arial\", 8))\n        canvas.create_text(190, 10, text=\"Weak\", fill=\"white\", font=(\"Arial\", 8))\n\n    def _setup_canvas(self):\n        self.canvas = tk.Canvas(self.right_frame, bg=\"#333\", cursor=\"cross\")\n        self.canvas.pack(fill=tk.BOTH, expand=True)\n        \n        # Bindings\n        self.canvas.bind(\"<Button-1>\", self.on_canvas_click)\n        self.canvas.bind(\"<B1-Motion>\", self.on_canvas_drag)\n        self.canvas.bind(\"<ButtonRelease-1>\", self.on_canvas_release)\n        self.canvas.bind(\"<MouseWheel>\", self.on_zoom)\n\n    # --- Core Logic ---\n\n    def poll_wifi(self):\n        if not self.running: return\n        self.current_wifi = get_wifi_info()\n        \n        # Update UI\n        self.lbl_ssid.config(text=f\"SSID: {self.current_wifi.get('ssid')}\")\n        self.lbl_bssid.config(text=f\"BSSID: {self.current_wifi.get('bssid')}\")\n        \n        sig = self.current_wifi.get('signal', 0)\n        color = \"green\" if sig > 60 else \"orange\" if sig > 40 else \"red\"\n        self.lbl_signal.config(text=f\"Signal: {sig}%\", fg=color)\n        \n        self.root.after(1000, self.poll_wifi) # Poll every 1 second\n\n    def open_live_monitor(self):\n        \"\"\"Opens a live graph window to track signal while walking.\"\"\"\n        win = tk.Toplevel(self.root)\n        win.title(\"Live Signal Monitor (Walking Mode)\")\n        win.geometry(\"600x400\")\n        \n        # Data container\n        x_data = deque(maxlen=60) # Last 60 seconds\n        y_data = deque(maxlen=60)\n        \n        # Setup Plot\n        fig = plt.Figure(figsize=(5, 4), dpi=100)\n        ax = fig.add_subplot(111)\n        line, = ax.plot([], [], 'g-', linewidth=2)\n        ax.set_ylim(0, 100)\n        ax.set_xlim(0, 60)\n        ax.set_title(\"Real-Time Signal Strength\")\n        ax.set_ylabel(\"Signal %\")\n        ax.set_xlabel(\"Time (Seconds ago)\")\n        ax.grid(True)\n        \n        canvas = FigureCanvasTkAgg(fig, master=win)\n        canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)\n        \n        def update_graph():\n            if not win.winfo_exists(): return\n            \n            sig = self.current_wifi.get('signal', 0)\n            x_data.append(len(x_data))\n            y_data.append(sig)\n            \n            # Recalculate x-axis to look like a scrolling tape\n            line.set_data(range(len(y_data)), y_data)\n            ax.set_xlim(0, max(60, len(y_data)))\n            \n            # Color code\n            if sig > 60: line.set_color('green')\n            elif sig > 40: line.set_color('orange')\n            else: line.set_color('red')\n            \n            canvas.draw()\n            win.after(1000, update_graph)\n            \n        update_graph()\n\n    def show_speedtest_graph(self):\n        if not self.speedtest_history:\n            messagebox.showinfo(\"No Data\", \"No speedtests run yet.\")\n            return\n\n        win = tk.Toplevel(self.root)\n        win.title(\"Speedtest History\")\n        win.geometry(\"600x500\")\n\n        fig = plt.Figure(figsize=(6, 5), dpi=100)\n        ax = fig.add_subplot(111)\n\n        indices = range(len(self.speedtest_history))\n        downloads = [x['download'] for x in self.speedtest_history]\n        uploads = [x['upload'] for x in self.speedtest_history]\n\n        bar_width = 0.35\n        ax.bar(indices, downloads, bar_width, label='Download (Mbps)', color='blue')\n        ax.bar([i + bar_width for i in indices], uploads, bar_width, label='Upload (Mbps)', color='orange')\n\n        ax.set_xlabel('Test Number')\n        ax.set_ylabel('Speed (Mbps)')\n        ax.set_title('Speedtest Results per Location')\n        ax.set_xticks([i + bar_width / 2 for i in indices])\n        ax.set_xticklabels([f\"Pt {i+1}\" for i in indices])\n        ax.legend()\n\n        canvas = FigureCanvasTkAgg(fig, master=win)\n        canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)\n\n    def load_floorplan(self):\n        path = filedialog.askopenfilename(filetypes=[(\"Images\", \"*.png;*.jpg;*.jpeg\")])\n        if path:\n            self.floorplan_img_orig = Image.open(path)\n            self.fit_image_to_canvas()\n\n    def fit_image_to_canvas(self):\n        if not self.floorplan_img_orig: return\n        cw = self.canvas.winfo_width()\n        ch = self.canvas.winfo_height()\n        iw, ih = self.floorplan_img_orig.size\n        \n        scale_w = cw / iw\n        scale_h = ch / ih\n        self.scale = min(scale_w, scale_h) * 0.9\n        \n        self.redraw_canvas()\n\n    def redraw_canvas(self):\n        self.canvas.delete(\"all\")\n        \n        if self.floorplan_img_orig:\n            # Resize image\n            iw, ih = self.floorplan_img_orig.size\n            nw, nh = int(iw * self.scale), int(ih * self.scale)\n            img_resized = self.floorplan_img_orig.resize((nw, nh), Image.Resampling.LANCZOS)\n            self.floorplan_photo = ImageTk.PhotoImage(img_resized)\n            \n            # Center image\n            cx = self.canvas.winfo_width() / 2 + self.offset_x\n            cy = self.canvas.winfo_height() / 2 + self.offset_y\n            \n            img_x_start = cx - (nw / 2)\n            img_y_start = cy - (nh / 2)\n            \n            # Draw Floorplan\n            self.canvas.create_image(cx, cy, image=self.floorplan_photo, anchor=\"center\", tags=\"floorplan\")\n            \n            # Draw Heatmap\n            if self.heatmap_photo:\n                self.canvas.create_image(cx, cy, image=self.heatmap_photo, anchor=\"center\", tags=\"heatmap_layer\")\n            \n            # Draw Walls (Lines)\n            for (x1, y1, x2, y2) in self.walls:\n                sx1 = img_x_start + (x1 * self.scale)\n                sy1 = img_y_start + (y1 * self.scale)\n                sx2 = img_x_start + (x2 * self.scale)\n                sy2 = img_y_start + (y2 * self.scale)\n                self.canvas.create_line(sx1, sy1, sx2, sy2, fill=\"red\", width=3, tags=\"walls\")\n\n            # Draw Points\n            for (px, py, signal) in self.survey_points:\n                screen_x = img_x_start + (px * self.scale)\n                screen_y = img_y_start + (py * self.scale)\n                \n                color = \"#00ff00\" if signal > 60 else \"#ffff00\" if signal > 40 else \"#ff0000\"\n                self.canvas.create_oval(screen_x-4, screen_y-4, screen_x+4, screen_y+4, fill=color, outline=\"black\", tags=\"points\")\n                self.canvas.create_text(screen_x, screen_y-10, text=f\"{signal}\", fill=\"black\", font=(\"Arial\", 8, \"bold\"), tags=\"points\")\n\n            # Draw Notes\n            for (nx, ny, text) in self.notes:\n                screen_x = img_x_start + (nx * self.scale)\n                screen_y = img_y_start + (ny * self.scale)\n                self.canvas.create_text(screen_x, screen_y, text=text, fill=\"blue\", font=(\"Arial\", 10, \"bold\"), tags=\"notes\")\n\n    def _get_rel_coords(self, event_x, event_y):\n        \"\"\"Convert screen coords to relative image coords.\"\"\"\n        cx = self.canvas.winfo_width() / 2 + self.offset_x\n        cy = self.canvas.winfo_height() / 2 + self.offset_y\n        iw, ih = self.floorplan_img_orig.size\n        nw, nh = int(iw * self.scale), int(ih * self.scale)\n        img_x_start = cx - (nw / 2)\n        img_y_start = cy - (nh / 2)\n        rel_x = (event_x - img_x_start) / self.scale\n        rel_y = (event_y - img_y_start) / self.scale\n        return rel_x, rel_y, iw, ih\n\n    def on_canvas_click(self, event):\n        if not self.floorplan_img_orig: return\n        mode = self.mode_var.get()\n        \n        if mode == \"pan\":\n            self.last_mouse_x = event.x\n            self.last_mouse_y = event.y\n            return\n\n        rel_x, rel_y, iw, ih = self._get_rel_coords(event.x, event.y)\n        \n        # Check bounds\n        if 0 <= rel_x <= iw and 0 <= rel_y <= ih:\n            \n            if mode == \"point\":\n                signal = self.current_wifi.get(\"signal\", 0)\n                self.survey_points.append((rel_x, rel_y, signal))\n                self.update_live_heatmap()\n                self.redraw_canvas()\n                \n            elif mode == \"line\":\n                self.line_start = (rel_x, rel_y)\n                \n            elif mode == \"text\":\n                text = simpledialog.askstring(\"Add Label\", \"Enter text for this location:\")\n                if text:\n                    self.notes.append((rel_x, rel_y, text))\n                    self.redraw_canvas()\n\n    def on_canvas_drag(self, event):\n        mode = self.mode_var.get()\n        \n        if mode == \"pan\":\n            dx = event.x - self.last_mouse_x\n            dy = event.y - self.last_mouse_y\n            self.offset_x += dx\n            self.offset_y += dy\n            self.last_mouse_x = event.x\n            self.last_mouse_y = event.y\n            self.redraw_canvas()\n            \n        elif mode == \"line\" and self.line_start and self.floorplan_img_orig:\n            # Rubber band line\n            self.canvas.delete(\"temp_line\")\n            # Get screen coords for start\n            cx = self.canvas.winfo_width() / 2 + self.offset_x\n            cy = self.canvas.winfo_height() / 2 + self.offset_y\n            iw, ih = self.floorplan_img_orig.size\n            nw, nh = int(iw * self.scale), int(ih * self.scale)\n            img_x_start = cx - (nw / 2)\n            img_y_start = cy - (nh / 2)\n            \n            sx = img_x_start + (self.line_start[0] * self.scale)\n            sy = img_y_start + (self.line_start[1] * self.scale)\n            \n            self.canvas.create_line(sx, sy, event.x, event.y, fill=\"red\", dash=(4, 4), tags=\"temp_line\")\n\n    def on_canvas_release(self, event):\n        mode = self.mode_var.get()\n        if mode == \"line\" and self.line_start:\n            self.canvas.delete(\"temp_line\")\n            rel_x, rel_y, iw, ih = self._get_rel_coords(event.x, event.y)\n            # Finish line\n            self.walls.append((self.line_start[0], self.line_start[1], rel_x, rel_y))\n            self.line_start = None\n            self.redraw_canvas()\n\n    def update_live_heatmap(self):\n        if len(self.survey_points) < 3: return\n\n        # 1. Extract Data\n        points = np.array([(p[0], p[1]) for p in self.survey_points]) \n        values = np.array([p[2] for p in self.survey_points])\n        \n        iw, ih = self.floorplan_img_orig.size\n        \n        # 2. Grid\n        step = max(5, int(iw / 100)) # Dynamic step size for speed\n        grid_x, grid_y = np.mgrid[0:iw:step, 0:ih:step]\n        \n        # 3. Interp\n        try:\n            grid_z = griddata(points, values, (grid_x, grid_y), method='linear')\n        except Exception as e:\n            return\n\n        # 4. Render\n        dpi = 72\n        fig = plt.Figure(figsize=(iw/dpi, ih/dpi), dpi=dpi)\n        fig.patch.set_alpha(0)\n        ax = fig.add_axes([0, 0, 1, 1])\n        ax.patch.set_alpha(0)\n        ax.axis('off')\n        \n        ax.imshow(grid_z.T, extent=(0, iw, ih, 0), origin='upper', \n                  cmap='RdYlGn', alpha=0.5, vmin=0, vmax=100, aspect='auto')\n\n        canvas = FigureCanvasAgg(fig)\n        canvas.draw()\n        buf = canvas.buffer_rgba()\n        array = np.asarray(buf)\n        \n        heatmap_pil = Image.fromarray(array)\n        nw, nh = int(iw * self.scale), int(ih * self.scale)\n        heatmap_resized = heatmap_pil.resize((nw, nh), Image.Resampling.LANCZOS)\n        \n        self.heatmap_photo = ImageTk.PhotoImage(heatmap_resized)\n        plt.close(fig)\n\n    from matplotlib.backends.backend_agg import FigureCanvasAgg\n\n    def on_zoom(self, event):\n        if event.delta > 0:\n            self.scale *= 1.1\n        else:\n            self.scale *= 0.9\n        self.redraw_canvas()\n\n    def clear_points(self):\n        if messagebox.askyesno(\"Confirm\", \"Clear all survey points and walls?\"):\n            self.survey_points = []\n            self.notes = [] \n            self.walls = []\n            self.heatmap_photo = None\n            self.redraw_canvas()\n\n    def trigger_speedtest(self):\n        self.root.config(cursor=\"watch\")\n        messagebox.showinfo(\"Speedtest\", \"Running speedtest in background...\\nThis may take 20-30 seconds.\")\n        run_background_speedtest(self._on_speedtest_done)\n\n    def _on_speedtest_done(self, results, error):\n        self.root.config(cursor=\"\")\n        if error:\n            messagebox.showerror(\"Error\", f\"Speedtest failed: {error}\")\n        else:\n            msg = f\"Download: {results['download']:.2f} Mbps\\nUpload: {results['upload']:.2f} Mbps\\nPing: {results['ping']} ms\"\n            messagebox.showinfo(\"Results\", msg)\n            \n            # Save to history for plotting\n            if self.floorplan_img_orig:\n                # Approximate location (center of screen or last click) - hard to pinpoint exactly without click context\n                # So we just store it sequentially\n                self.speedtest_history.append(results)\n            else:\n                self.speedtest_history.append(results)\n\nif __name__ == \"__main__\":\n    root = tk.Tk()\n    app = WifiSurveyApp(root)\n    root.mainloop()","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}